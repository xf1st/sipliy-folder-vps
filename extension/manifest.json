{
  "manifest_version": 3,
  "name": "Sipliy Folder VPS",
  "version": "2.4.4",
  "description": "Скачивайте файлы на VPS правым кликом. Следите за прогрессом и забирайте на ПК — прямо из расширения.",
  "minimum_chrome_version": "100",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "downloads",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sipliy Folder VPS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
