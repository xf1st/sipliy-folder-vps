{
  "name": "vps-sync-manager",
  "version": "1.1.0",
  "description": "VPS Sync Manager — desktop sync client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "chokidar":        "^3.6.0",
    "node-fetch":      "^2.7.0"
  },
  "devDependencies": {
    "electron":        "^31.7.7",
    "electron-builder":"^24.13.3"
  },
  "build": {
    "appId": "com.vps.syncmanager",
    "productName": "VPS Sync Manager",
    "win": { "target": "nsis" }
  }
}
